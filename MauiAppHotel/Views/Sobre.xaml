<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre">
    
    <VerticalStackLayout>
        
        <Label 
            Text="Sobre" FontSize="30" FontAttributes="Bold"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            Margin="0,30,0,20"/>

        <Label Text="O aplicativo foi desenvolvido por Carolina Vaz, 
               em 2026, para um projeto do curso de 
               Desenvolvimento de Sistemas da ETEC." 
               VerticalOptions="Center"
               HorizontalOptions="Center"/>

        <Button Text="Voltar" 
                HorizontalOptions="Center"
                BackgroundColor="Grey"
                Margin="0,30,0,0" 
                Clicked="Button_Clicked"/>

    </VerticalStackLayout>
</ContentPage>